# Copie para .env:  cp .env.example .env
# O docker compose lê o .env automaticamente. Nunca versione o .env real.

# Banco #
DB_NAME=betman
DB_USERNAME=betman
DB_PASSWORD=betman
# Dentro do Docker o host é o nome do serviço ("db"), não localhost
DB_URL=jdbc:postgresql://db:5432/betman

# Portas no seu computador #
APP_PORT=8080
# 5433 evita conflito com um PostgreSQL instalado localmente na 5432
DB_PORT=5433

# Imagem #
# Imagem publicada pelo CI. Para fixar uma versão, troque latest pelo sha curto (ex.: :a1b2c3d)
BETMAN_IMAGE=ghcr.io/grogww/betman:latest

#  Aplicação #
# Porta interna do container (mantenha 8080, igual ao Dockerfile)
SERVER_PORT=8080
BETMAN_LOG_LEVEL=DEBUG
BETMAN_SIMULATION_ENABLED=true

# PROMETHEUS #
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d

# grafana #
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=