# Copie para .env:  cp .env.example .env
# O docker compose lê o .env automaticamente. Nunca versione o .env real.

# ---------- Banco ----------
DB_NAME=betman
DB_USERNAME=betman
DB_PASSWORD=betman
# Dentro do Docker o host é o nome do serviço ("db"), não localhost
DB_URL=jdbc:postgresql://db:5432/betman

# ---------- Portas no seu computador ----------
APP_PORT=8080
DB_PORT=5432

# ---------- Aplicação ----------
# Porta interna do container (mantenha 8080, igual ao Dockerfile)
SERVER_PORT=8080
BETMAN_LOG_LEVEL=DEBUG
BETMAN_SIMULATION_ENABLED=true
